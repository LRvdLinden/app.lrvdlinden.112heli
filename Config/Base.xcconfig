// Shared build settings for all 112Heli targets (app, Apple TV, widgets).
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 12
DEVELOPMENT_TEAM = EU3UY476T6

// The app's own API (Cloudflare Worker in worker/). "//" starts a comment in .xcconfig, hence https:/$()/
HELI_API_URL = https:/$()/112heli-api.112heli.workers.dev

// Links in Instellingen. Empty = the link is hidden. Fill in before the App Store release.
HELI_PRIVACY_URL = https:/$()/112heli.lrvdlinden.app/privacy/
HELI_SUPPORT_URL = https:/$()/112heli.lrvdlinden.app/support/

// Optional local overrides (not in git), e.g. a local wrangler dev URL while testing.
#include? "Secrets.xcconfig"
